#compdef bluetoothctl

_bluetoothctl() {
  local state

  _arguments -C \
    '1:action:(connect disconnect list power devices)' \
    '2:argument:->args'

  case $state in
    args)
      case $words[2] in
        connect)
          local -a macs descs
          for line in ${(f)"$(bluetoothctl devices)"}; do
            local parts=(${=line})
            local mac=${parts[2]}
            local name=${parts[@]:3}
            macs+=("$mac")
            descs+=("$mac -- $name")
          done
          compadd -Q -d descs -- $macs
        ;;
        disconnect)
          local -a macs descs
          for line in ${(f)"$(bluetoothctl devices Connected)"}; do
            local parts=(${=line})
            local mac=${parts[2]}
            local name=${parts[@]:3}
            macs+=("$mac")
            descs+=("$mac -- $name")
          done
          compadd -Q -d descs -- $macs
        ;;
        power)
          compadd on off
        ;;
        devices)
          compadd Paired Bonded Trusted Connected
        ;;
      esac
    ;;
  esac
}

_bluetoothctl "$@"
